{
  "$schema": "https://dl.viam.dev/module.schema.json",
  "module_id": "viam:camera-calibration",
  "visibility": "public",
  "url": "https://github.com/viam-labs/camera-calibration",
  "description": "Camera calibration for robotic arms.",
  "models": [
    {
      "api": "rdk:component:pose_tracker",
      "model": "viam:camera-calibration:charuco",
      "short_description": "ChArUco board pose tracker.",
      "markdown_link": "README.md"
    },
    {
      "api": "rdk:service:generic",
      "model": "viam:camera-calibration:eye_in_hand",
      "short_description": "Hand-eye calibration for arm-mounted cameras.",
      "markdown_link": "README.md"
    },
    {
      "api": "rdk:service:generic",
      "model": "viam:camera-calibration:eye_to_hand",
      "short_description": "Hand-eye calibration for static cameras with the board on the arm.",
      "markdown_link": "README.md"
    },
    {
      "api": "rdk:service:generic",
      "model": "viam:camera-calibration:handeye",
      "short_description": "Deprecated alias for eye_in_hand.",
      "markdown_link": "README.md"
    },
    {
      "api": "rdk:service:discovery",
      "model": "viam:camera-calibration:charuco-discovery",
      "short_description": "Auto-detect ChArUco board parameters from a depth camera and emit a charuco pose_tracker config.",
      "markdown_link": "README.md"
    }
  ],
  "applications": null,
  "markdown_link": "README.md",
  "entrypoint": "bin/camera-calibration",
  "first_run": "first_run.sh",
  "build": {
    "build": "make module.tar.gz",
    "setup": "make setup",
    "path": "module.tar.gz",
    "arch": [
      "linux/amd64",
      "linux/arm64",
      "darwin/arm64"
    ]
  }
}